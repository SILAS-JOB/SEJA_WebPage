

@model SEJA_WebApp.Models.AccountModelView
@{
    ViewData["Title"] = "Minha Conta";
}

<div class="container" style="margin-top: 100px;">
    <div class="row">
        <div class="col-md-3 text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" class="img-fluid rounded-circle" alt="Foto de Perfil" style="width: 150px; height: 150px;"/>
            }
            <h3 class="mt-3">@Model.Name</h3>
            <p class="text-muted">@Model.Email</p>

            <form asp-controller="Login" asp-action="Logout" method="post" class="mt-4">
                <button type="submit" class="btn btn-danger">Sair (Logout)</button>
            </form>
        </div>

        <div class="col-md-9">
            <h2>Detalhes da Conta</h2>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">
                    @{
                        var idClaim = Model.AllClaims.FirstOrDefault(c => c.Type == "Id");
                    }
                    @(idClaim != null ? idClaim.Value : "N/A")
                </dd>

                <dt class="col-sm-3">Nome Completo</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Primeiro Nome</dt>
                <dd class="col-sm-9">@Model.GivenName</dd>

                <dt class="col-sm-3">Sobrenome</dt>
                <dd class="col-sm-9">@Model.SurName</dd>

                <dt class="col-sm-3">Endereço de E-mail</dt>
                <dd class="col-sm-9">@Model.Email</dd>
            </dl>
        </div>
    </div>
</div>