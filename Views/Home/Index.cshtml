@section Estilos {
    <link rel="stylesheet" href="~/css/index.css" />
}
@section Scripts {
  <script src="~/js/web.js" asp-append-version="true"></script>
}

<br/>
@if (Context.User.Identity.IsAuthenticated) 
{
  <div id="loginMessage" class="alert alert-success text-center pt-3 mt-5" role="alert">
        <h5><i><b><u>Seja bem-vindo, usuário autenticado ✅</u></b></i></h5>
  </div>
} else 
{
<div id="loginMessage"class="alert alert-danger text-center pt-3 mt-5" role="alert">
        <h5><b><i><u>Usuário não pode ser autenticado, tente novamente ❌</u></i></b></h5>
    </div>}


<div class="justify-content-start">
  <div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img class="carousel-img" src="https://static.vecteezy.com/ti/fotos-gratis/p1/9259171-engenheiros-homens-trabalhando-no-local-de-construcao-gerente-e-engenheiro-encontro-e-discussao-sobre-projeto-no-canteiro-de-obra-gratis-foto.JPG" class="d-block w-100" alt="...">
      </div>
      <div class="carousel-item">
        <img src="https://thumbs.dreamstime.com/b/homem-no-trabalho-em-um-canteiro-de-obras-47668338.jpg" class="d-block w-100" alt="...">
      </div>
      <div class="carousel-item">
        <img src="https://api.aecweb.com.br/tematico/img_figuras/tendencias-construcao-civil-2025-reforma-tributaria-2._Olho%24%240.webp" class="d-block w-100" alt="...">
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
  <div class="container">
    <div class="row">
      <div class="col text-center pt-5">
        <h1 class="text-center mt-4 fade-in">Sistema de Ensino Jorge Augusto</h1>
        <br>
        <h3 class="fade-in"><i><b>Quem somos ?</b></i></h3>
        <br>
        <p class="text-center fade-in">
            No SEJA, acreditamos que cada aluno é único — e o ensino também deve ser. Nossa missão é oferecer um ambiente de aprendizagem personalizado, inclusivo e acolhedor, onde as habilidades e necessidades individuais são reconhecidas e respeitadas.
            Mais do que reforço escolar, somos parceiros no desenvolvimento acadêmico e pessoal de cada estudante, trabalhando lado a lado com famílias e escolas.
        </p>
        <hr>
      </div>
    </div>
