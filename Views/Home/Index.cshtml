@section Estilos {
    <link rel="stylesheet" href="~/css/index.css" />
}
@section Scripts {
  <script src="~/js/web.js" ></script>
}

<br/>
@if (Context.User.Identity.IsAuthenticated) 
{

<p id="loginMessage" class="bs-sucess">Seja bem vindo @User.Identity.IsAuthenticated</p>
} else 
{
  <p id="loginMessage" class="bs-danger">Usuário não pode ser autenticado, tente novamente</p>
}


<div class="justify-content-start">
  <div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img class="carousel-img" src="https://static.vecteezy.com/ti/fotos-gratis/p1/9259171-engenheiros-homens-trabalhando-no-local-de-construcao-gerente-e-engenheiro-encontro-e-discussao-sobre-projeto-no-canteiro-de-obra-gratis-foto.JPG" class="d-block w-100" alt="...">
      </div>
      <div class="carousel-item">
        <img src="https://thumbs.dreamstime.com/b/homem-no-trabalho-em-um-canteiro-de-obras-47668338.jpg" class="d-block w-100" alt="...">
      </div>
      <div class="carousel-item">
        <img src="https://api.aecweb.com.br/tematico/img_figuras/tendencias-construcao-civil-2025-reforma-tributaria-2._Olho%24%240.webp" class="d-block w-100" alt="...">
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
