<div class="container">
    <br>
    <div class="row">
        <div class="col">
            <h2>Cadastre-se</h2>
            <br>
            <div class="social-login">
            <p>Ou entre com:</p>
                <a class="btn btn-outline-danger" href="/signin-google">Google</a>
                <a class="btn btn-outline-primary" href="/signin-facebook">Facebook</a>
            </div>
            <br>
            <label for="nome">Nome:</label>
            <input type="text" id="nome" class="form-control" placeholder="Digite seu nome" />
            <br>
            <label for="email">E-mail:</label>
            <input type="email" id="email" class="form-control" placeholder="Digite seu e-mail" />
            <br>
            <label for="telefone">Telefone:</label>
            <input type="text" id="telefone" class="form-control" placeholder="Digite seu telefone" />
            <br>
            <label for="senha">Senha:</label>
            <input type="password" id="senha" class="form-control" placeholder="Digite sua senha" />
            <br>
            <label for="confirmarSenha">Confirmar Senha:</label>
            <input type="password" id="confirmarSenha" class="form-control" placeholder="Confirme sua senha" />
            <br>
            <button class="btn btn-primary mt-2">Cadastrar</button>
            
        </div>
        <div class="col">
            <h2>Faça Login</h2>
            <br>
            <label for="loginEmail">E-mail:</label>
            <input type="email" id="loginEmail" class="form-control" placeholder="Digite seu e-mail" />
            <br>
            <label for="loginSenha">Senha:</label>
            <input type="password" id="loginSenha" class="form-control" placeholder="Digite sua senha" />
            <br>
            <button class="btn btn-primary mt-2">Entrar</button>
            <br>
            <a href="#" class="mt-2">Esqueci minha senha</a>
        </div>
    </div>
</div>