@{
    ViewBag.Title = "Faça Login ou Crie sua Conta";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/login.css" />
}


<body class="pt-5 mt-5">
    <div class="container">
        <br>
        <div class="row">
            <div class="col">
                <h2>Cadastre-se</h2>
                <br>
                <div class="social-login">
                <p>Ou entre com Google</p>
                <a asp-controller="Login" asp-action="Login" class="google-btn">
                    <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google Logo">
                    Sign in with Google
                </a>
                </div>
                <br>
                <label for="nome">Nome:</label>
                <input type="text" id="Name" class="form-control" placeholder="Digite seu nome" />
                <br>
                <label for="email">E-mail:</label>
                <input type="email" id="Email" class="form-control" placeholder="Digite seu e-mail" />
                <br>
                <label for="telefone">Telefone:</label>
                <input type="text" id="PhoneNumber" class="form-control" placeholder="Digite seu telefone" />
                <br>
                <label for="senha">Senha:</label>
                <input type="password" id="Password" class="form-control" placeholder="Digite sua senha" />
                <br>
                <label for="confirmarSenha">Confirmar Senha:</label>
                <input type="password" id="ConfirmPassoword" class="form-control" placeholder="Confirme sua senha" />
                <br>
                <button class="btn btn-primary mt-2">Cadastrar</button>

            </div>
            <div class="col">
                <h2>Faça Login</h2>
                <br>
                <label for="loginEmail">E-mail:</label>
                <input type="email" id="loginEmail" class="form-control" placeholder="Digite seu e-mail" />
                <br>
                <label for="loginSenha">Senha:</label>
                <input type="password" id="loginSenha" class="form-control" placeholder="Digite sua senha" />
                <br>
                <button class="btn btn-primary mt-2">Entrar</button>
                <br>
                <a href="#" class="mt-2">Esqueci minha senha</a>
            </div>
        </div>
    </div>
</body>
