@{
    ViewData["Title"] = "Agende sua Aula";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/aulas.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
}

<div class="schedule-container">
    <div class="page-header">
        <i class="fa-solid fa-calendar-alt icon-header"></i>
        <h1>Agende sua Aula</h1>
        <p>Escolha o melhor horário e aprenda com a gente!</p>
    </div>

    <div class="options-grid">
        <div class="option-card individual">
            <div class="icon-wrapper"><i class="fa-solid fa-user"></i></div>
            <h3>Aula Individual</h3>
            <p>Tenha acompanhamento personalizado com um de nossos professores.</p>
        </div>

        <div class="option-card group">
            <div class="icon-wrapper"><i class="fa-solid fa-users"></i></div>
            <h3>Aula em Grupo</h3>
            <p>Interaja e aprenda com colegas em um ambiente colaborativo.</p>
        </div>

        <div class="option-card online">
            <div class="icon-wrapper"><i class="fa-solid fa-video"></i></div>
            <h3>Aula Online</h3>
            <p>Aprenda de qualquer lugar com nossas aulas online ao vivo.</p>
        </div>
    </div>

    <div class="commitment-section">
        <a class="btn-commitment" target="_blank" href="https://calendar.google.com/calendar/appointments/schedules/AcZssZ2zbAJdW0d8-Xm7tSKNz9Ndte7lbugj5jAnFa1UBNKZARJj1TIlTm7HiowVOGUk0WTdG7GnFrkS?gv=true" 
        >Agendar um compromisso !
        </a>
    </div>
</div>