@{
    ViewData["Title"] = "Reserve nosso Espaço";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/reservas.css" />
    
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
}

<div class="booking-container">
    <div class="page-header">
        <i class="fa-solid fa-building-user icon-header"></i>
        <h1>Reserve nosso Espaço</h1>
        <p>Utilize nossas salas para seus eventos, reuniões ou workshops.</p>
    </div>

    <div class="options-grid">
        <div class="option-card meeting-room">
            <div class="icon-wrapper"><i class="fa-solid fa-users-line"></i></div>
            <h3>Sala de Reuniões</h3>
            <p>Perfeita para encontros de negócios e pequenas apresentações.</p>
        </div>

        <div class="option-card auditorium">
            <div class="icon-wrapper"><i class="fa-solid fa-person-chalkboard"></i></div>
            <h3>Sala de Aula</h3>
            <p>Ideal para palestras, workshops e eventos maiores.</p>
        </div>
    </div>

    <div class="commitment-section">
        <a class="btn-commitment"target="_blank" href="https://calendar.google.com/calendar/appointments/schedules/AcZssZ2zbAJdW0d8-Xm7tSKNz9Ndte7lbugj5jAnFa1UBNKZARJj1TIlTm7HiowVOGUk0WTdG7GnFrkS?gv=true"
        >Reservar Agora !</a>
    </div>
</div>